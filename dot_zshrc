# ~/.zshrc — slim loader. Tool/shell config lives in ~/.config/zsh/*.zsh
export PATH="$HOME/.local/bin:$PATH"

# Source modular config in order (00-options, 10-exports, 20-tools, ...)
for _zf in "$HOME"/.config/zsh/[0-9]*.zsh; do
  [ -r "$_zf" ] && source "$_zf"
done
unset _zf

# The tail of startup is order-critical and lives in the numbered files above:
#   70-prompt.zsh   → oh-my-posh
#   90-shell-ux.zsh → autosuggestions → zoxide → syntax-highlighting (do not reorder)
